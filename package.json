{
  "name": "@cntryl/lexkey",
  "version": "0.1.0",
  "description": "Lexicographically-sortable binary key encodings for numbers, strings, UUIDs and composites.",
  "homepage": "https://github.com/cntryl/lexkey-ts#readme",
  "bugs": {
    "url": "https://github.com/cntryl/lexkey-ts/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cntryl/lexkey-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
